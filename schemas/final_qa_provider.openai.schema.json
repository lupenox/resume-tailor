{
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "issues", "technical_failure"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["pass", "material_findings", "technical_failure"]
    },
    "summary": {"type": "string"},
    "issues": {
      "type": "array",
      "maxItems": 12,
      "items": {"$ref": "#/$defs/provider_issue"}
    },
    "technical_failure": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/technical_failure"}
      ]
    }
  },
  "$defs": {
    "provider_issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "severity",
        "description",
        "affected_content_id",
        "evidence_source_ids",
        "correction_action",
        "correction_objective"
      ],
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "factual_integrity",
            "unsupported_wording",
            "grammar",
            "clarity",
            "duplication",
            "ats_alignment",
            "clipping",
            "overflow",
            "layout",
            "readability",
            "content_budget"
          ]
        },
        "severity": {"type": "string", "enum": ["high", "medium"]},
        "description": {"type": "string"},
        "affected_content_id": {
          "anyOf": [
            {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"},
            {"type": "null"}
          ]
        },
        "evidence_source_ids": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]+$"
          }
        },
        "correction_action": {
          "type": "string",
          "enum": [
            "verify_factual_integrity",
            "remove_unsupported_claim",
            "correct_grammar",
            "improve_clarity",
            "remove_duplication",
            "improve_ats_alignment",
            "resolve_clipping",
            "resolve_overflow",
            "improve_layout",
            "improve_readability",
            "meet_content_budget"
          ]
        },
        "correction_objective": {"type": "string"}
      }
    },
    "technical_failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason_code", "description"],
      "properties": {
        "reason_code": {
          "type": "string",
          "enum": [
            "provider_failure",
            "image_unavailable",
            "evidence_unavailable",
            "output_constraint",
            "other_technical_failure"
          ]
        },
        "description": {"type": "string"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex resume-to-job analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "role_summary",
    "fit_assessment",
    "supported_requirement_mappings",
    "unsupported_requirement_ids",
    "recommended_edits",
    "immutable_facts",
    "forbidden_claims",
    "content_budget_guidance",
    "questions_for_user"
  ],
  "properties": {
    "role_summary": {"type": "string", "minLength": 1},
    "fit_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall", "strengths", "gaps"],
      "properties": {
        "overall": {"type": "string", "minLength": 1},
        "strengths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "gaps": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "supported_requirement_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "evidence_source_ids", "strength"],
        "properties": {
          "requirement_id": {"type": "string", "minLength": 1},
          "evidence_source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "strength": {"type": "string", "enum": ["strong", "partial", "weak"]}
        }
      }
    },
    "unsupported_requirement_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "recommended_edits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_source_id",
          "operation",
          "proposed_text",
          "alignment_rationale",
          "evidence_source_ids"
        ],
        "properties": {
          "target_source_id": {"type": "string", "minLength": 1},
          "operation": {"type": "string", "enum": ["replace", "append"]},
          "proposed_text": {"type": "string", "minLength": 1},
          "alignment_rationale": {"type": "string", "minLength": 1},
          "evidence_source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "immutable_facts": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "forbidden_claims": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "content_budget_guidance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_source_id", "guidance"],
        "properties": {
          "target_source_id": {"type": "string", "minLength": 1},
          "guidance": {"type": "string", "minLength": 1}
        }
      }
    },
    "questions_for_user": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Antigravity LinkedIn job extraction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fetch_status",
    "requested_url",
    "final_resolved_url",
    "linkedin_job_id",
    "job_title",
    "company",
    "location",
    "workplace_type",
    "employment_type",
    "salary",
    "normalized_job_description",
    "responsibilities",
    "required_qualifications",
    "preferred_qualifications",
    "technologies_and_skills",
    "ai_focus_areas",
    "warnings"
  ],
  "properties": {
    "fetch_status": {
      "type": "string",
      "enum": [
        "success",
        "login_required",
        "expired",
        "unavailable",
        "insufficient_content",
        "permission_denied",
        "extraction_failed"
      ]
    },
    "requested_url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "final_resolved_url": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 2048}
      ]
    },
    "linkedin_job_id": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9]{5,20}$"}
      ]
    },
    "job_title": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 300}
      ]
    },
    "company": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 300}
      ]
    },
    "location": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 500}
      ]
    },
    "workplace_type": {
      "type": "string",
      "enum": ["remote", "hybrid", "on-site", "unspecified"]
    },
    "employment_type": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 200}
      ]
    },
    "salary": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 500}
      ]
    },
    "normalized_job_description": {
      "type": "string",
      "maxLength": 200000
    },
    "responsibilities": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 5000}
    },
    "required_qualifications": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 5000}
    },
    "preferred_qualifications": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 5000}
    },
    "technologies_and_skills": {
      "type": "array",
      "maxItems": 300,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "ai_focus_areas": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "warnings": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    }
  }
}

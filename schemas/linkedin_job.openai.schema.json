{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fetch_status",
    "requested_url",
    "final_resolved_url",
    "linkedin_job_id",
    "job_title",
    "company",
    "location",
    "workplace_type",
    "employment_type",
    "salary",
    "normalized_job_description",
    "responsibilities",
    "required_qualifications",
    "preferred_qualifications",
    "technologies_and_skills",
    "ai_focus_areas",
    "warnings"
  ],
  "properties": {
    "fetch_status": {
      "type": "string",
      "enum": [
        "success",
        "login_required",
        "expired",
        "unavailable",
        "insufficient_content",
        "url_mismatch",
        "job_id_mismatch",
        "search_unavailable",
        "provider_failure",
        "malformed_output"
      ]
    },
    "requested_url": {
      "type": "string"
    },
    "final_resolved_url": {
      "anyOf": [
        {"type": "null"},
        {"type": "string"}
      ]
    },
    "linkedin_job_id": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9]{5,20}$"}
      ]
    },
    "job_title": {
      "anyOf": [
        {"type": "null"},
        {"type": "string"}
      ]
    },
    "company": {
      "anyOf": [
        {"type": "null"},
        {"type": "string"}
      ]
    },
    "location": {
      "anyOf": [
        {"type": "null"},
        {"type": "string"}
      ]
    },
    "workplace_type": {
      "type": "string",
      "enum": ["remote", "hybrid", "on-site", "unspecified"]
    },
    "employment_type": {
      "anyOf": [
        {"type": "null"},
        {"type": "string"}
      ]
    },
    "salary": {
      "anyOf": [
        {"type": "null"},
        {"type": "string"}
      ]
    },
    "normalized_job_description": {
      "type": "string"
    },
    "responsibilities": {
      "type": "array",
      "maxItems": 200,
      "items": {"type": "string"}
    },
    "required_qualifications": {
      "type": "array",
      "maxItems": 200,
      "items": {"type": "string"}
    },
    "preferred_qualifications": {
      "type": "array",
      "maxItems": 200,
      "items": {"type": "string"}
    },
    "technologies_and_skills": {
      "type": "array",
      "maxItems": 300,
      "items": {"type": "string"}
    },
    "ai_focus_areas": {
      "type": "array",
      "maxItems": 100,
      "items": {"type": "string"}
    },
    "warnings": {
      "type": "array",
      "maxItems": 100,
      "items": {"type": "string"}
    }
  }
}

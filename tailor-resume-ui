#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

APP_DIR="${SCRIPT_DIR}"
if [[ ! -d "${APP_DIR}/resume_tailor" ]]; then
  DATA_ROOT=""
  if [[ -n "${XDG_DATA_HOME:-}" ]]; then
    DATA_ROOT="${XDG_DATA_HOME}"
  elif [[ -n "${HOME:-}" ]]; then
    DATA_ROOT="${HOME}/.local/share"
  fi
  if [[ -n "${DATA_ROOT}" && -d "${DATA_ROOT}/resume-tailor/resume_tailor" ]]; then
    APP_DIR="${DATA_ROOT}/resume-tailor"
  fi
fi

if [[ -x "${APP_DIR}/.venv/bin/python" ]]; then
  PYTHON_BIN="${APP_DIR}/.venv/bin/python"
else
  PYTHON_BIN="${PYTHON_BIN:-python3}"
fi

export PYTHONPATH="${APP_DIR}${PYTHONPATH:+:${PYTHONPATH}}"
exec "${PYTHON_BIN}" -m resume_tailor.ui_cli "$@"

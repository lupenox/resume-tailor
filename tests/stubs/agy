#!/usr/bin/env python3
from __future__ import annotations

import hashlib
import json
import os
import subprocess
import sys
import time
from pathlib import Path


if "--version" in sys.argv:
    print("1.1.8-stub")
    raise SystemExit(0)

try:
    prompt_index = sys.argv.index("--prompt")
except ValueError:
    print("missing --prompt print-mode flag", file=sys.stderr)
    raise SystemExit(2)
if (
    prompt_index + 1 < len(sys.argv)
    and not sys.argv[prompt_index + 1].startswith("-")
):
    print("prompt content must not be transported in argv", file=sys.stderr)
    raise SystemExit(30)
if any(len(argument.encode("utf-8")) > 4096 for argument in sys.argv):
    print("large prompt-like argv item rejected", file=sys.stderr)
    raise SystemExit(31)

prompt_bytes = sys.stdin.buffer.read()
try:
    prompt = prompt_bytes.decode("utf-8")
except UnicodeDecodeError:
    print("stdin prompt was not valid UTF-8", file=sys.stderr)
    raise SystemExit(32)
if not prompt:
    print("missing stdin prompt", file=sys.stderr)
    raise SystemExit(33)

try:
    output_format = sys.argv[sys.argv.index("--output-format") + 1]
except (ValueError, IndexError):
    print("missing --output-format value", file=sys.stderr)
    raise SystemExit(37)
if output_format != "stream-json":
    print("Antigravity tailoring must use stream-json output", file=sys.stderr)
    raise SystemExit(38)


def emit_event(event: dict[str, object]) -> None:
    print(json.dumps(event, ensure_ascii=False), flush=True)


def emit_result(result: dict[str, object]) -> None:
    emit_event(
        {
            "event": "init",
            "init": {
                "conversation_id": "00000000-0000-4000-8000-000000000000"
            },
        }
    )
    emit_event({"event": "result", "result": result})

prompt_hash = hashlib.sha256(prompt_bytes).hexdigest()
is_revision = "This is revision attempt 1 of 1" in prompt
provider_role = "resume_revision_writer" if is_revision else "tailored_resume_writer"
transport_log = os.environ.get("STUB_AGY_TRANSPORT_LOG")
if transport_log:
    Path(transport_log).write_text(
        json.dumps(
            {
                "argv_count": len(sys.argv),
                "argv_total_bytes": sum(
                    len(argument.encode("utf-8")) + 1 for argument in sys.argv
                ),
                "max_argv_item_bytes": max(
                    len(argument.encode("utf-8")) for argument in sys.argv
                ),
                "payload_bytes": len(prompt_bytes),
                "payload_sha256": prompt_hash,
                "transport": "stdin",
                "role": provider_role,
                "output_format": output_format,
            },
            sort_keys=True,
        )
        + "\n",
        encoding="utf-8",
    )
invocation_log = os.environ.get("STUB_AGY_INVOCATION_LOG")
if invocation_log:
    with Path(invocation_log).open("a", encoding="utf-8") as handle:
        handle.write(
            json.dumps(
                {
                    "role": provider_role,
                    "output_format": output_format,
                    "sandboxed": "--sandbox" in sys.argv,
                }
            )
            + "\n"
        )
expected_bytes = os.environ.get("STUB_AGY_EXPECTED_STDIN_BYTES")
expected_hash = os.environ.get("STUB_AGY_EXPECTED_STDIN_SHA256")
if expected_bytes is not None and int(expected_bytes) != len(prompt_bytes):
    print("stdin prompt length mismatch", file=sys.stderr)
    raise SystemExit(34)
if expected_hash is not None and expected_hash != prompt_hash:
    print("stdin prompt hash mismatch", file=sys.stderr)
    raise SystemExit(35)

pid_log = os.environ.get("STUB_AGY_PID_LOG")
if pid_log:
    Path(pid_log).write_text(f"{os.getpid()}\n", encoding="ascii")

mode = (
    os.environ.get("STUB_AGY_REVISION_MODE", "ready")
    if is_revision
    else os.environ.get("STUB_AGY_MODE", "ready")
)
if mode == "hang":
    child = subprocess.Popen(
        [sys.executable, "-c", "import time; time.sleep(60)"],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    child_pid_log = os.environ.get("STUB_AGY_CHILD_PID_LOG")
    if child_pid_log:
        Path(child_pid_log).write_text(f"{child.pid}\n", encoding="ascii")
    time.sleep(60)
if mode == "process_error":
    print("stub Antigravity failure", file=sys.stderr)
    raise SystemExit(8)
if mode == "process_error_after_partial":
    emit_event({"event": "init", "init": {"status": "started"}})
    print("stub Antigravity failure after a partial stream", file=sys.stderr)
    raise SystemExit(8)
if mode == "bad_json":
    print("not-json")
    raise SystemExit(0)
if mode == "incomplete_stream":
    print('{"event":"result","result":', flush=True)
    raise SystemExit(0)
if mode == "missing_terminal":
    emit_event({"event": "init", "init": {"status": "started"}})
    raise SystemExit(0)
if mode == "wrapper_waiting":
    emit_result({"status": "WAITING", "message": "Stub is waiting."})
    raise SystemExit(0)

begin = (
    "BEGIN_CURRENT_TAILORED_CONTENT\n"
    if is_revision
    else "BEGIN_TRUSTED_MASTER_RESUME_CONTENT\n"
)
end = (
    "\nEND_CURRENT_TAILORED_CONTENT"
    if is_revision
    else "\nEND_TRUSTED_MASTER_RESUME_CONTENT"
)
if "--mode=plan" in sys.argv:
    print("tailoring must not run in generic plan mode", file=sys.stderr)
    raise SystemExit(36)
try:
    content_text = prompt.split(begin, 1)[1].split(end, 1)[0]
    master_content = json.loads(content_text)
except (IndexError, json.JSONDecodeError) as exc:
    print(f"could not parse trusted master content: {exc}", file=sys.stderr)
    raise SystemExit(3)

if mode == "unstructured_print_wrapper":
    emit_result(
        {
            "conversation_id": "00000000-0000-4000-8000-000000000000",
            "duration_seconds": 1.25,
            "num_turns": 2,
            "response": (
                "Synthetic prose must not be scanned for "
                '{"status":"complete"} fragments.'
            ),
            "status": "SUCCESS",
            "usage": {
                "cache_read_tokens": 10,
                "input_tokens": 20,
                "output_tokens": 5,
                "thinking_tokens": 2,
                "total_tokens": 25,
            },
        }
    )
    raise SystemExit(0)

if is_revision and mode in {"cannot_apply", "invalid_issue"}:
    structured = {
        "status": "cannot_apply",
        "message": "One synthetic QA correction could not be applied.",
        "cannot_apply": {
            "issue_id": "qa.999" if mode == "invalid_issue" else "qa.001",
            "reason_code": "content_budget_conflict",
            "reason": "Synthetic content-budget conflict.",
        },
        "technical_failure": None,
        "tailored_resume": None,
    }
elif is_revision and mode == "technical_failure":
    structured = {
        "status": "technical_failure",
        "message": "Synthetic revision output failure.",
        "cannot_apply": None,
        "technical_failure": {
            "reason_code": "structured_output_failure",
            "reason": "Synthetic revision output failure.",
        },
        "tailored_resume": None,
    }
elif mode == "waiting":
    structured = {
        "status": "WAITING",
        "message": (
            "Plan mode activated. Ready after synthetic requirements are provided."
        ),
        "questions_for_user": ["What synthetic task would you like to plan?"],
        "tailored_resume": None,
    }
elif mode == "error":
    structured = {
        "status": "ERROR",
        "message": "Synthetic legacy technical failure.",
        "questions_for_user": [],
        "tailored_resume": None,
    }
elif mode in {"cannot_apply", "invalid_edit"}:
    structured = {
        "status": "cannot_apply",
        "message": "One synthetic approved edit could not be applied.",
        "cannot_apply": {
            "edit_id": "edit.999" if mode == "invalid_edit" else "edit.001",
            "reason_code": "content_budget_conflict",
            "reason": "Synthetic content-budget conflict.",
        },
        "technical_failure": None,
        "tailored_resume": None,
    }
elif mode == "technical_failure":
    structured = {
        "status": "technical_failure",
        "message": "Synthetic structured-output failure.",
        "cannot_apply": None,
        "technical_failure": {
            "reason_code": "structured_output_failure",
            "reason": "Synthetic structured-output failure.",
        },
        "tailored_resume": None,
    }
else:
    if is_revision:
        revised = json.loads(json.dumps(master_content))
        if mode == "outside_target":
            revised["education"]["coursework"]["text"] += " Synthetic drift."
        elif mode == "unsupported_technology":
            revised["professional_summary"] += " GraphQL expertise."
        elif mode == "structural_drift":
            revised["projects"] = revised["projects"][:2]
        elif mode == "content_budget":
            revised["professional_summary"] += " " + ("x" * 500)
        elif mode != "unchanged":
            first, separator, remainder = revised["professional_summary"].partition(" ")
            revised["professional_summary"] = (
                f"{first}, {remainder}" if separator else revised["professional_summary"]
            )
        master_content = revised
    structured = {
        "status": "complete",
        "message": "Stubbed approved edits are complete.",
        "cannot_apply": None,
        "technical_failure": None,
        "tailored_resume": master_content,
    }
if mode == "string":
    structured_output = json.dumps(structured, ensure_ascii=False)
else:
    structured_output = structured
wrapper_status = "WAITING" if mode == "wrapper_waiting_complete" else None
output = {"structured_output": structured_output}
if wrapper_status is not None:
    output["status"] = wrapper_status
    output["message"] = "Incidental synthetic wrapper prose."
if mode == "schema_invalid":
    output["structured_output"] = {
        "status": "complete",
        "message": "Synthetic incomplete response.",
    }
if mode == "conflicting_candidates":
    conflicting = dict(structured)
    conflicting["message"] = "Conflicting synthetic representation."
    output["response"] = json.dumps(conflicting, ensure_ascii=False)
emit_result(output)
if mode == "multiple_terminal":
    emit_event({"event": "result", "result": output})

#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import sys
from pathlib import Path


if "--version" in sys.argv:
    print("codex-cli stub-0.0")
    raise SystemExit(0)

try:
    output_path = Path(sys.argv[sys.argv.index("--output-last-message") + 1])
except (ValueError, IndexError):
    print("missing --output-last-message", file=sys.stderr)
    raise SystemExit(2)
try:
    transport_schema_path = Path(sys.argv[sys.argv.index("--output-schema") + 1])
    transport_schema = json.loads(transport_schema_path.read_text(encoding="utf-8"))
except (ValueError, IndexError, OSError, json.JSONDecodeError):
    print("missing or invalid --output-schema", file=sys.stderr)
    raise SystemExit(2)


def schema_keywords(value: object):
    if isinstance(value, dict):
        for key, child in value.items():
            yield key
            yield from schema_keywords(child)
    elif isinstance(value, list):
        for child in value:
            yield from schema_keywords(child)


for unsupported in ("uniqueItems", "minLength", "maxLength"):
    if unsupported in set(schema_keywords(transport_schema)):
        print(
            f"invalid_json_schema: unsupported keyword {unsupported}",
            file=sys.stderr,
        )
        raise SystemExit(22)

schema_log = os.environ.get("STUB_CODEX_SCHEMA_LOG")
if schema_log:
    with Path(schema_log).open("a", encoding="utf-8") as handle:
        handle.write(f"{transport_schema_path}\n")

prompt = sys.stdin.read()
if not prompt:
    print("missing UTF-8 stdin prompt", file=sys.stderr)
    raise SystemExit(2)
output_path.parent.mkdir(parents=True, exist_ok=True)

if "Perform a fresh, read-only final QA review" in prompt:
    role = "final_qa"
else:
    role = "resume_analysis"

qa_generation = None
if role == "final_qa":
    qa_generation = "revision-1" if "generation revision-1" in prompt else "initial"

invocation_log = os.environ.get("STUB_CODEX_INVOCATION_LOG")
if invocation_log:
    with Path(invocation_log).open("a", encoding="utf-8") as handle:
        handle.write(
            json.dumps(
                {
                    "role": role,
                    "generation": qa_generation,
                    "cwd": str(Path.cwd()),
                    "ephemeral": "--ephemeral" in sys.argv,
                    "sandbox": (
                        sys.argv[sys.argv.index("--sandbox") + 1]
                        if "--sandbox" in sys.argv
                        else None
                    ),
                }
            )
            + "\n"
        )

mode = os.environ.get("STUB_CODEX_MODE", "ready")
if "--search" in sys.argv:
    print("live search is allowed only for LinkedIn retrieval", file=sys.stderr)
    raise SystemExit(46)

if mode == "process_error":
    print("stub Codex failure", file=sys.stderr)
    raise SystemExit(9)
if mode == "bad_json":
    output_path.write_text("not-json", encoding="utf-8")
    raise SystemExit(0)

if role == "final_qa":
    required_qa_flags = {"--ignore-user-config", "--ephemeral", "--sandbox"}
    if not required_qa_flags.issubset(sys.argv):
        print("final QA missing fresh read-only flags", file=sys.stderr)
        raise SystemExit(49)
    if sys.argv[sys.argv.index("--sandbox") + 1] != "read-only":
        print("final QA sandbox must be read-only", file=sys.stderr)
        raise SystemExit(50)
    try:
        preview_path = Path(sys.argv[sys.argv.index("--image") + 1])
    except (ValueError, IndexError):
        print("final QA is missing its rendered preview", file=sys.stderr)
        raise SystemExit(47)
    if not preview_path.is_file():
        print("final QA started before the rendered preview existed", file=sys.stderr)
        raise SystemExit(48)
    qa_mode = os.environ.get(
        "STUB_CODEX_QA_REVISION_MODE"
        if qa_generation == "revision-1"
        else "STUB_CODEX_QA_INITIAL_MODE",
        mode,
    )
    if qa_mode == "qa_bad_json":
        output_path.write_text("not-json", encoding="utf-8")
        raise SystemExit(0)
    if qa_mode == "qa_fail":
        payload = {
            "status": "material_findings",
            "summary": "A material visual issue needs review.",
            "issues": [
                {
                    "category": "clarity",
                    "severity": "medium",
                    "description": "The synthetic summary needs a bounded clarity correction.",
                    "affected_content_id": "professional_summary",
                    "evidence_source_ids": ["professional_summary"],
                    "correction_action": "improve_clarity",
                    "correction_objective": "Improve clarity without adding or replacing facts.",
                }
            ],
            "technical_failure": None,
        }
    elif qa_mode == "qa_technical_failure":
        payload = {
            "status": "technical_failure",
            "summary": "Synthetic QA could not complete reliably.",
            "issues": [],
            "technical_failure": {
                "reason_code": "image_unavailable",
                "description": "Synthetic preview inspection failed.",
            },
        }
    elif qa_mode == "qa_unknown_category":
        payload = {
            "status": "material_findings",
            "summary": "Synthetic invalid category.",
            "issues": [
                {
                    "category": "rewrite_everything",
                    "severity": "medium",
                    "description": "Synthetic invalid category.",
                    "affected_content_id": "professional_summary",
                    "evidence_source_ids": [],
                    "correction_action": "improve_clarity",
                    "correction_objective": "Synthetic objective.",
                }
            ],
            "technical_failure": None,
        }
    elif qa_mode == "qa_unknown_content_id":
        payload = {
            "status": "material_findings",
            "summary": "Synthetic unknown content ID.",
            "issues": [
                {
                    "category": "clarity",
                    "severity": "medium",
                    "description": "Synthetic unknown content ID.",
                    "affected_content_id": "unknown.content",
                    "evidence_source_ids": [],
                    "correction_action": "improve_clarity",
                    "correction_objective": "Synthetic objective.",
                }
            ],
            "technical_failure": None,
        }
    elif qa_mode == "qa_replacement_text":
        payload = {
            "status": "material_findings",
            "summary": "Synthetic forbidden replacement wording.",
            "issues": [
                {
                    "category": "clarity",
                    "severity": "medium",
                    "description": "Synthetic finding.",
                    "affected_content_id": "professional_summary",
                    "evidence_source_ids": [],
                    "correction_action": "improve_clarity",
                    "correction_objective": "Synthetic objective.",
                    "replacement_resume_text": "Forbidden replacement wording.",
                }
            ],
            "technical_failure": None,
        }
    else:
        payload = {
            "status": "pass",
            "summary": "Stubbed read-only QA passed.",
            "issues": [],
            "technical_failure": None,
        }
else:
    requirement_ids = transport_schema["properties"][
        "unsupported_requirement_ids"
    ]["items"]["enum"]
    catalog_marker = "BEGIN_LOCAL_JOB_REQUIREMENT_CATALOG\n"
    catalog_end = "\nEND_LOCAL_JOB_REQUIREMENT_CATALOG"
    catalog = json.loads(
        prompt.split(catalog_marker, 1)[1].split(catalog_end, 1)[0]
    )
    requirement_text = {
        item["requirement_id"]: item["exact_text"]
        for item in catalog["requirements"]
    }
    supported_id = next(
        (
            requirement_id
            for requirement_id in requirement_ids
            if requirement_text.get(requirement_id, "").casefold() == "python"
        ),
        requirement_ids[0],
    )
    questions = ["Please confirm a factual detail."] if mode == "questions" else []
    payload = {
        "role_summary": "Stubbed target role analysis.",
        "fit_assessment": {
            "overall": "Supported fit based on the supplied master resume.",
            "strengths": ["Agentic AI project evidence"],
            "gaps": ["No unsupported experience should be claimed"],
        },
        "supported_requirement_mappings": [
            {
                "requirement_id": supported_id,
                "evidence_source_ids": ["skill_groups.0"],
                "strength": "strong",
            }
        ],
        "unsupported_requirement_ids": [
            requirement_id
            for requirement_id in requirement_ids
            if requirement_id != supported_id
        ],
        "recommended_edits": [],
        "immutable_facts": [
            "Example Institute",
            "Synthetic credential",
            "2024–Present",
        ],
        "forbidden_claims": [
            "RAG",
            "GraphQL",
            "distributed production scale",
        ],
        "content_budget_guidance": [],
        "questions_for_user": questions,
    }
    if mode == "duplicates":
        payload["fit_assessment"]["strengths"].append(
            payload["fit_assessment"]["strengths"][0]
        )
        payload["supported_requirement_mappings"].append(
            payload["supported_requirement_mappings"][0]
        )
    if mode == "source_id_failure":
        payload["recommended_edits"] = [
            {
                "target_source_id": "professional_summary",
                "operation": "replace",
                "proposed_text": "Synthetic proposed text.",
                "alignment_rationale": "Synthetic regression case.",
                "evidence_source_ids": ["paragraph 3 describes the summary"],
            }
        ]
    if mode == "empty_source_ids":
        payload["supported_requirement_mappings"][0]["evidence_source_ids"] = [""]

output_path.write_text(
    json.dumps(payload, ensure_ascii=False),
    encoding="utf-8",
)
print("stub complete")

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitHub repository evidence requests",
  "type": "object",
  "additionalProperties": false,
  "required": ["shortlist_repository_ids", "requests"],
  "properties": {
    "shortlist_repository_ids": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "requests": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository_id",
          "request_type",
          "path",
          "requirement_ids",
          "evidence_ids"
        ],
        "properties": {
          "repository_id": {"type": "string", "minLength": 1},
          "request_type": {
            "type": "string",
            "enum": ["repository_file"]
          },
          "path": {"type": "string", "minLength": 1},
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}

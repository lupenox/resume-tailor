{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resume writer one-shot resume revision response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "message",
    "cannot_apply",
    "technical_failure",
    "tailored_resume"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["complete", "cannot_apply", "technical_failure"]
    },
    "message": {"type": "string", "minLength": 1, "maxLength": 500},
    "cannot_apply": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["issue_id", "reason_code", "reason"],
          "properties": {
            "issue_id": {"type": "string", "pattern": "^qa\\.[0-9]{3}$"},
            "reason_code": {
              "type": "string",
              "enum": [
                "correction_not_supported",
                "approved_boundary_conflict",
                "immutable_fact_conflict",
                "content_budget_conflict",
                "structure_conflict",
                "other_bounded_constraint"
              ]
            },
            "reason": {"type": "string", "minLength": 1, "maxLength": 500}
          }
        }
      ]
    },
    "technical_failure": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason_code", "reason"],
          "properties": {
            "reason_code": {
              "type": "string",
              "enum": [
                "provider_unavailable",
                "structured_output_failure",
                "internal_tool_failure",
                "output_constraint",
                "other_technical_failure"
              ]
            },
            "reason": {"type": "string", "minLength": 1, "maxLength": 500}
          }
        }
      ]
    },
    "tailored_resume": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/resume"}
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "complete"}}},
      "then": {
        "properties": {
          "tailored_resume": {"$ref": "#/$defs/resume"},
          "cannot_apply": {"type": "null"},
          "technical_failure": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "cannot_apply"}}},
      "then": {
        "properties": {
          "cannot_apply": {"type": "object"},
          "technical_failure": {"type": "null"},
          "tailored_resume": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "technical_failure"}}},
      "then": {
        "properties": {
          "cannot_apply": {"type": "null"},
          "technical_failure": {"type": "object"},
          "tailored_resume": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "labelled_text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "text"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "technologies", "bullets"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "technologies": {"type": "string", "minLength": 1},
        "bullets": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "maxItems": 8
        }
      }
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "professional_summary",
        "education",
        "skill_groups",
        "projects",
        "open_source",
        "experience"
      ],
      "properties": {
        "professional_summary": {"type": "string", "minLength": 1},
        "education": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "institution",
            "degree_details",
            "coursework",
            "certifications"
          ],
          "properties": {
            "institution": {"type": "string", "minLength": 1},
            "degree_details": {"type": "string", "minLength": 1},
            "coursework": {"$ref": "#/$defs/labelled_text"},
            "certifications": {"$ref": "#/$defs/labelled_text"}
          }
        },
        "skill_groups": {
          "type": "array",
          "items": {"$ref": "#/$defs/labelled_text"},
          "minItems": 3,
          "maxItems": 3
        },
        "projects": {
          "type": "array",
          "items": {"$ref": "#/$defs/project"},
          "minItems": 3,
          "maxItems": 3
        },
        "open_source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "technologies", "bullet"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "technologies": {"type": "string", "minLength": 1},
            "bullet": {"type": "string", "minLength": 1}
          }
        },
        "experience": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "employer_location", "dates", "bullets"],
          "properties": {
            "role": {"type": "string", "minLength": 1},
            "employer_location": {"type": "string", "minLength": 1},
            "dates": {"type": "string", "minLength": 1},
            "bullets": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "minItems": 1,
              "maxItems": 4
            }
          }
        }
      }
    }
  }
}
